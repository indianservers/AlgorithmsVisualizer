    },
    {
      "id": "sort-right",
      "text": "        sort(mid, high);"
    },
    {
      "id": "copy-halves",
      "text": "        const left = a.slice(low, mid), right = a.slice(mid, high);"
    },
    {
      "text": "        let i = 0, j = 0, k = low;"
