    {
      "id": "compare-right",
      "text": "            if (a[right] > a[largest])"
    },
    {
      "text": "                largest = right;"
    },
    {
      "text": "        }"
    },
    {
      "text": "        if (largest !== root) {"
    },
    {
      "id": "heap-swap",
      "text": "            [a[root], a[largest]] = [a[largest], a[root]];"
    },
    {
      "text": "            heapify(size, largest);"
    },
    {
      "text": "        }"
    },
    {
      "text": "    }"
    },
    {
      "id": "initialize",
      "text": "    for (let i = Math.floor(a.length / 2) - 1; i >= 0; i--)"
