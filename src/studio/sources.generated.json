    },
    {
      "text": "    }"
    },
    {
      "text": "    let k = 0;"
    },
    {
      "id": "bucket-loop",
      "text": "    for (let bucket = 0; bucket < counts.length; bucket++) {"
    },
    {
      "id": "inner-loop",
      "text": "        for (let repeat = 0; repeat < counts[bucket]; repeat++) {"
    },
    {
      "id": "write",
      "text": "            a[k] = bucket + min;"
    },
    {
      "text": "            k++;"
    },
    {
      "text": "        }"
    },
    {
      "text": "    }"
    },
    {
      "id": "return",
