  "counting-sort": [
    {
      "text": "function counting(a, target) {"
    },
    {
      "id": "initialize",
      "text": "    const min = Math.min(...a, 0), max = Math.max(...a, 0);"
    },
    {
      "id": "allocate",
      "text": "    const counts = Array(max - min + 1).fill(0);"
    },
    {
      "id": "outer-loop",
      "text": "    for (let i = 0; i < a.length; i++) {"
    },
    {
      "id": "count",
