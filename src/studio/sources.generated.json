    {
      "text": "function shell(a, target) {"
    },
    {
      "id": "initialize",
      "text": "    const n = a.length;"
    },
    {
      "id": "outer-loop",
      "text": "    for (let gap = Math.floor(n / 2); gap > 0; gap = Math.floor(gap / 2)) {"
