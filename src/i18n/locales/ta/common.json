{
  "s_72053dfc": "வரைபடங்கள்",
  "s_c98b74eb": "டைனமிக் புரோகிராமிங்",
  "s_affc10d9": "கணினி அறிவியலில் பேராசை நெறிமுறைகள்",
  "s_92f30caf": "பின்னோக்கி தேடல் அல்காரிதம்கள்",
  "s_afaef1ef": "வரிசைப்படுத்துதல்",
  "s_8c5ceb17": "தேடுகிறது",
  "s_3c0c37af": "காட்சிப்படுத்தல்",
  "s_2524e8b5": "கற்றுக்கொள்ளுங்கள்",
  "s_795db914": "குறியீடு",
  "s_ec65ee90": "பயிற்சி",
  "s_3230fc93": "சோதனைகள்",
  "s_73f99d3c": "விளையாட்டுகள்",
  "s_52f50eae": "வீடு",
  "s_831e749c": "ஒப்பிடுங்கள் ",
  "s_6a5234fd": " அல்காரிதங்கள்",
  "s_8b67f168": "இலக்கு",
  "s_c0d3b17b": "அல்காரிதங்கள்",
  "s_617c747e": "அல்காரிதம் வடிவமைப்பு மற்றும் பகுப்பாய்வு பற்றிய கருத்துக்கள்",
  "s_84c25be4": "அல்காரிதம் பகுப்பாய்வு மற்றும் சரியானது",
  "s_a3ac1e94": "அல்காரிதம்களைப் பிரித்து வெற்றிகொள்ளவும்",
  "s_e8cb71b0": "கிளை மற்றும் கட்டுப்பட்ட தேர்வுமுறை அல்காரிதம்கள்",
  "s_658664de": "சிக்கலான கோட்பாடு",
  "s_78992b11": "மேம்பட்ட அல்காரிதம் வடிவமைப்பு நுட்பங்கள்",
  "s_983315a5": "தரவு கட்டமைப்புகள்",
  "s_8808a489": "எண் கோட்பாடு",
  "s_72384d57": "மேட்ரிக்ஸ் / கட்டம்",
  "s_d0c27b03": "தரவுத்தொகுப்பு",
  "s_d57a0a54": "ஒப்பிடுங்கள்",
  "s_4d2d5d68": "சேமிக்கவும்",
  "s_a6478e7c": "அளவு",
  "s_4115d182": "சீரற்றது",
  "s_aac7941d": " அல்காரிதங்கள்",
  "s_c646a2c9": "தேடுங்கள்",
  "s_838e4139": " காட்சிப்படுத்தல்",
